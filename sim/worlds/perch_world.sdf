<?xml version="1.0" ?>
<!--
  PERCH simulation world.

  UAV velocity control (body frame twist):
    gz topic -t "/X3/gazebo/command/twist" -m gz.msgs.Twist -p "linear: {x:0 y:0 z:0.5} angular {z:0}"

  UGV velocity control:
    gz topic -t "/model/perch_ugv/cmd_vel" -m gz.msgs.Twist -p "linear: {x:0.3} angular {z:0}"

  Requires sim/models on GZ_SIM_RESOURCE_PATH (see scripts/run_sim.sh) and the
  X3 UAV fuel model patched with cameras (see scripts/setup_sim_assets.sh).
-->
<sdf version="1.6">
  <world name="perch">
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.45 0.52 0.62 1</ambient>
      <background>0.72 0.84 0.95 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.28 0.42 0.22 1</ambient>
            <diffuse>0.34 0.52 0.27 1</diffuse>
            <specular>0.08 0.1 0.06 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="survey_grid_overlay">
      <static>true</static>
      <link name="link">
        <visual name="survey_area">
          <pose>0 0 0.012 0 0 0</pose>
          <geometry>
            <box>
              <size>17 17 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.2 0.45 0.22</ambient>
            <diffuse>0.05 0.35 0.8 0.22</diffuse>
          </material>
        </visual>
        <visual name="survey_lane_0">
          <pose>0 -8 0.025 0 0 0</pose>
          <geometry><box><size>16.5 0.08 0.01</size></box></geometry>
          <material><ambient>0.05 0.45 1 0.75</ambient><diffuse>0.05 0.45 1 0.75</diffuse></material>
        </visual>
        <visual name="survey_lane_1">
          <pose>0 -4 0.025 0 0 0</pose>
          <geometry><box><size>16.5 0.08 0.01</size></box></geometry>
          <material><ambient>0.05 0.45 1 0.75</ambient><diffuse>0.05 0.45 1 0.75</diffuse></material>
        </visual>
        <visual name="survey_lane_2">
          <pose>0 0 0.025 0 0 0</pose>
          <geometry><box><size>16.5 0.08 0.01</size></box></geometry>
          <material><ambient>0.05 0.45 1 0.75</ambient><diffuse>0.05 0.45 1 0.75</diffuse></material>
        </visual>
        <visual name="survey_lane_3">
          <pose>0 4 0.025 0 0 0</pose>
          <geometry><box><size>16.5 0.08 0.01</size></box></geometry>
          <material><ambient>0.05 0.45 1 0.75</ambient><diffuse>0.05 0.45 1 0.75</diffuse></material>
        </visual>
        <visual name="survey_lane_4">
          <pose>0 8 0.025 0 0 0</pose>
          <geometry><box><size>16.5 0.08 0.01</size></box></geometry>
          <material><ambient>0.05 0.45 1 0.75</ambient><diffuse>0.05 0.45 1 0.75</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="service_road">
      <static>true</static>
      <pose>10 8.5 0.025 0 0 0</pose>
      <link name="link">
        <visual name="asphalt">
          <geometry>
            <box>
              <size>42 3.2 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.12 0.12 0.12 1</ambient>
            <diffuse>0.16 0.16 0.15 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>42 3.2 0.04</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="road_centerline">
      <static>true</static>
      <pose>10 8.5 0.055 0 0 0</pose>
      <link name="link">
        <visual name="stripe">
          <geometry>
            <box>
              <size>38 0.08 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.8 0.45 1</ambient>
            <diffuse>0.85 0.8 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="operations_pad">
      <static>true</static>
      <pose>6 0 0.018 0 0 0</pose>
      <link name="link">
        <visual name="concrete">
          <geometry><box><size>12 10 0.03</size></box></geometry>
          <material>
            <ambient>0.34 0.35 0.35 1</ambient>
            <diffuse>0.42 0.43 0.42 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>12 10 0.03</size></box></geometry>
        </collision>
      </link>
    </model>

    <include>
      <name>depot_building</name>
      <pose>18 10 0 0 0 -1.57</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Depot/6</uri>
    </include>

    <include>
      <name>lake_house</name>
      <pose>-18 12 0 0 0 0.25</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Lake House/3</uri>
    </include>

    <include>
      <name>barrier_0</name>
      <pose>10 5.9 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier/6</uri>
    </include>
    <include>
      <name>barrier_1</name>
      <pose>14 5.9 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier/6</uri>
    </include>
    <include>
      <name>barrier_2</name>
      <pose>18 5.9 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier/6</uri>
    </include>

    <include>
      <name>construction_barrel_0</name>
      <pose>13 -7 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Barrel/4</uri>
    </include>
    <include>
      <name>construction_barrel_1</name>
      <pose>15 -7.5 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Barrel/4</uri>
    </include>

    <include>
      <name>oak_tree_0</name>
      <pose>-20 -14 0 0 0 0</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak Tree/7</uri>
    </include>
    <include>
      <name>oak_tree_1</name>
      <pose>-15 17 0 0 0 0.4</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak Tree/7</uri>
    </include>
    <include>
      <name>oak_tree_2</name>
      <pose>23 -11 0 0 0 -0.3</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak Tree/7</uri>
    </include>
    <include>
      <name>pine_tree_0</name>
      <pose>-23 5 0 0 0 0.2</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree/6</uri>
    </include>
    <include>
      <name>pine_tree_1</name>
      <pose>24 15 0 0 0 -0.2</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree/6</uri>
    </include>

    <model name="radio_tower">
      <static>true</static>
      <pose>20 -12 0 0 0 0</pose>
      <link name="link">
        <visual name="mast">
          <pose>0 0 3 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>6</length></cylinder></geometry>
          <material><ambient>0.55 0.08 0.06 1</ambient><diffuse>0.7 0.12 0.08 1</diffuse></material>
        </visual>
        <visual name="crossbar_0">
          <pose>0 0 4.5 0 1.5707 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>2.2</length></cylinder></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
        <visual name="crossbar_1">
          <pose>0 0 5.4 1.5707 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>1.6</length></cylinder></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include>
      <name>perch_ugv</name>
      <pose>3 0 0 0 0 0</pose>
      <uri>perch_ugv</uri>
    </include>

    <model name="payload">
      <pose>0 0 0.05 0 0 0</pose>
      <link name="payload_link">
        <inertial>
          <mass>0.15</mass>
          <inertia>
            <ixx>0.0001</ixx>
            <iyy>0.0001</iyy>
            <izz>0.0001</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.08 0.08 0.06</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.6 0.1 1</ambient>
            <diffuse>0.9 0.6 0.1 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.08 0.08 0.06</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <include>
      <name>X3</name>
      <pose>0 0 0.1 0 0 0</pose>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/X3 UAV/6
      </uri>
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>X3/rotor_0_joint</jointName>
        <linkName>X3/rotor_0</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>800.0</maxRotVelocity>
        <motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>0</actuator_number>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>X3/rotor_1_joint</jointName>
        <linkName>X3/rotor_1</linkName>
        <turningDirection>ccw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>800.0</maxRotVelocity>
        <motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>1</actuator_number>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>X3/rotor_2_joint</jointName>
        <linkName>X3/rotor_2</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>800.0</maxRotVelocity>
        <motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>2</actuator_number>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/2</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
        <robotNamespace>X3</robotNamespace>
        <jointName>X3/rotor_3_joint</jointName>
        <linkName>X3/rotor_3</linkName>
        <turningDirection>cw</turningDirection>
        <timeConstantUp>0.0125</timeConstantUp>
        <timeConstantDown>0.025</timeConstantDown>
        <maxRotVelocity>800.0</maxRotVelocity>
        <motorConstant>8.54858e-06</motorConstant>
        <momentConstant>0.016</momentConstant>
        <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
        <actuator_number>3</actuator_number>
        <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
        <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
        <motorSpeedPubTopic>motor_speed/3</motorSpeedPubTopic>
        <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        <motorType>velocity</motorType>
      </plugin>
      <plugin filename="gz-sim-multicopter-control-system" name="gz::sim::systems::MulticopterVelocityControl">
        <robotNamespace>X3</robotNamespace>
        <commandSubTopic>gazebo/command/twist</commandSubTopic>
        <enableSubTopic>enable</enableSubTopic>
        <comLinkName>X3/base_link</comLinkName>
        <velocityGain>2.7 2.7 2.7</velocityGain>
        <attitudeGain>2 3 0.15</attitudeGain>
        <angularRateGain>0.4 0.52 0.18</angularRateGain>
        <maximumLinearAcceleration>2 2 2</maximumLinearAcceleration>
        <rotorConfiguration>
          <rotor>
            <jointName>X3/rotor_0_joint</jointName>
            <forceConstant>8.54858e-06</forceConstant>
            <momentConstant>0.016</momentConstant>
            <direction>1</direction>
          </rotor>
          <rotor>
            <jointName>X3/rotor_1_joint</jointName>
            <forceConstant>8.54858e-06</forceConstant>
            <momentConstant>0.016</momentConstant>
            <direction>1</direction>
          </rotor>
          <rotor>
            <jointName>X3/rotor_2_joint</jointName>
            <forceConstant>8.54858e-06</forceConstant>
            <momentConstant>0.016</momentConstant>
            <direction>-1</direction>
          </rotor>
          <rotor>
            <jointName>X3/rotor_3_joint</jointName>
            <forceConstant>8.54858e-06</forceConstant>
            <momentConstant>0.016</momentConstant>
            <direction>-1</direction>
          </rotor>
        </rotorConfiguration>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <dimensions>3</dimensions>
      </plugin>
      <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
        <parent_link>X3/base_link</parent_link>
        <child_model>payload</child_model>
        <child_link>payload_link</child_link>
        <detach_topic>/X3/payload/detach</detach_topic>
      </plugin>
    </include>
  </world>
</sdf>
